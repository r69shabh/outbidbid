{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "outbidbid",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "outbidbid",
      "database_id": "97087313-2a79-4ac3-b6dd-e6840eff86c7"
    }
  ],
  "workers_dev": true,
  "routes": [
    { "pattern": "tinyspot.lol", "custom_domain": true },
    { "pattern": "outbidbid.lol", "custom_domain": true }
  ],
  "vars": {
    "DODO_BASE": "https://live.dodopayments.com",
    "DODO_PRODUCT_ID": "pdt_0Nm2g6AkVcf4sSybPOz5T"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PRESENCE",
        "class_name": "PresenceTracker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PresenceTracker"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
